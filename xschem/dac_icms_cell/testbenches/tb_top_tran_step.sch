C {devices/code_shown.sym} -1215 695 0 0 {name=NGSPICE
simulator=ngspice
only_toplevel=false 
value="
.param temp=27
.param period = 2n
.param wp = 1.5u
.param wn = 0.5u
.param rise_t = period*0.01
.param fall_t = period*0.01
.param delay_n = 0
.param delay_s = 0
.param delay_2 = period*0.2
.param delay_1 = period*0
.options savecurrents klu method=gear reltol=1e-2 abstol=1e-15 gmin=1e-10

.control
set hcopydevtype = svg
set color0 = white
set color1 = black

tran .1p 4n



plot vin1 vin2 vin3 vin4 v_top1 v_top2 v_top3 v_top4
plot vin1a v_top1a
plot vin1a+2 sample+2 v_top v_top_sample
plot v_top v_top1 v_top_sample 
plo vin_ac v_top_ac v_top_ac_sin_dummies

hardcopy ./../../img/rise_top.svg vin1 vin2 vin3 vin4 v_top1 v_top2 v_top3 v_top4 xlimit 1n 1.1n title 'Pulso de subida'
hardcopy ./../../img/fall_top.svg vin1 vin2 vin3 vin4 v_top1 v_top2 v_top3 v_top4 xlimit 4n 4.1n title 'Pulso de bajada'
hardcopy ./../../img/rise_topa.svg vin1  v_top1 v_top1a xlimit 4n 4.1n title 'Pulso de subida de 1024 circuitos en paralelo'
hardcopy ./../../img/delays_sah.svg v_top v_top1 v_top_sample xlimit 1n 1.1n title 'Comparativa Retardos'
hardcopy ./../../img/respuesta_c.svg vin_ac v_top_ac_sample_rapido  title 'Ejemplo de sample a 80MHz'
hardcopy ./../../img/sample_rapido_vs_lento_dummies.svg vin_ac  v_top_ac_sample_rapido v_top_ac_sample_lento  v_top_ac_sin_dummies title 'Efecto del tiempo de bajada de sample en la inyeccion de carga'
hardcopy ./../../img/sample_rapido_vs_lento_dummies_zoom.svg vin_ac  v_top_ac_sample_rapido v_top_ac_sample_lento  v_top_ac_sin_dummies ylimit 1.7 1.9 xlimit 3.4n 3.8n title 'Efecto del tiempo de bajada de sample en la inyeccion de carga'
.endc
"}
